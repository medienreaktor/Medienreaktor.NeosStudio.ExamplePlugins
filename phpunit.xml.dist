<?xml version="1.0" encoding="UTF-8"?>
<!--
    The unit suite only. A functional suite (Tests/Functional) boots Flow and runs
    inside a distribution with Neos.BuildEssentials' FunctionalTests.xml instead, in
    the functional workflow. Tests/Unit/.gitkeep keeps the directory until the first
    test lands; PHPUnit then reports "No tests executed!" and passes.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnRisky="true"
         failOnWarning="true">
    <testsuites>
        <testsuite name="Unit">
            <directory>Tests/Unit</directory>
        </testsuite>
    </testsuites>
</phpunit>
