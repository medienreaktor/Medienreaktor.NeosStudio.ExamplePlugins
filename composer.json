{
    "name": "medienreaktor/neos-studio-example-plugins",
    "type": "neos-package",
    "description": "Boilerplate showing how to extend Neos Studio from a separate package: registers an example panel and an example inspector property editor.",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": "^8.2",
        "neos/neos": "^9.1",
        "medienreaktor/neos-studio": "^1.19.1"
    },
    "require-dev": {
        "neos/contentgraph-doctrinedbaladapter": "^9.1"
    },
    "extra": {
        "neos": {
            "package-key": "Medienreaktor.NeosStudio.ExamplePlugins"
        },
        "branch-alias": {
            "dev-main": "1.1.x-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "neos/composer-plugin": true
        }
    },
    "scripts": {
        "lint:composer": "@composer validate --strict --no-check-lock",
        "lint": [
            "@lint:composer"
        ]
    }
}
