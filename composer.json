{
    "name": "medienreaktor/neos-studio-example-plugins",
    "type": "neos-package",
    "description": "Boilerplate showing how to extend Neos Studio from a separate package: a panel, an inspector property editor, a keyboard shortcut and a node decorator, built with Studio's UI components (plugin API version 2).",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": "^8.4",
        "neos/neos": "^9.2",
        "medienreaktor/neos-studio": "^2.0.5"
    },
    "require-dev": {
        "neos/contentgraph-doctrinedbaladapter": "^9.2"
    },
    "extra": {
        "neos": {
            "package-key": "Medienreaktor.NeosStudio.ExamplePlugins"
        },
        "branch-alias": {
            "dev-main": "2.0.x-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "neos/composer-plugin": true
        }
    },
    "scripts": {
        "lint:composer": "@composer validate --strict --no-check-lock",
        "lint": [
            "@lint:composer"
        ]
    }
}
